        "intent_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "started_at": {
          "$ref": "#/$defs/UtcDateTime"
        },
        "upstream_job_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "intent_id",
        "upstream_job_id",
        "event_cursor",
        "started_at",
        "ended_at"
      ],
      "title": "AttemptOperational",
      "type": "object"
    },
