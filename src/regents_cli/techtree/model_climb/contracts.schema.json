    "ExecutionGrant": {
      "additionalProperties": false,
      "description": "One operation on one resolved plan, within these limits; signed by its issuer's key.\n\nEvery field is bound: the signature covers them all, so changing any one breaks it.",
      "properties": {
        "actor_key_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "approving_human": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "attestation": {
          "$ref": "#/$defs/GrantAttestation"
        },
        "benchmark_release": {
          "$ref": "#/$defs/Digest"
        },
        "dataset_release": {
          "$ref": "#/$defs/Digest"
        },
        "egress": {
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "title": "Egress",
          "type": "array"
        },
        "expires_at": {
          "$ref": "#/$defs/UtcDateTime"
        },
        "gpu_count": {
          "$ref": "#/$defs/Positive"
        },
        "gpu_model": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "grant_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "issued_at": {
          "$ref": "#/$defs/UtcDateTime"
        },
        "issuer_key_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "kind": {
          "const": "ExecutionGrant",
          "title": "Kind",
          "type": "string"
        },
        "max_attempts": {
          "$ref": "#/$defs/Positive"
        },
        "max_cents": {
          "$ref": "#/$defs/Cents"
        },
        "max_parallel_jobs": {
          "$ref": "#/$defs/Positive"
        },
        "max_wall_time_seconds": {
          "$ref": "#/$defs/Positive"
        },
        "mission": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "mode": {
          "const": "local",
          "title": "Mode",
          "type": "string"
        },
        "nonce": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Nonce",
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/GrantedOperation"
        },
        "plan": {
          "$ref": "#/$defs/Digest"
        },
        "provider": {
          "$ref": "#/$defs/ComputeProvider"
        },
        "recipe": {
          "$ref": "#/$defs/Digest"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "uses_allowed": {
          "$ref": "#/$defs/Positive"
        },
        "workspace": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "grant_id",
        "mode",
        "issuer_key_id",
        "approving_human",
        "workspace",
        "actor_key_id",
        "operation",
        "plan",
        "dataset_release",
        "benchmark_release",
        "recipe",
        "provider",
        "mission",
        "gpu_model",
        "gpu_count",
        "max_cents",
        "max_wall_time_seconds",
        "max_attempts",
        "max_parallel_jobs",
        "egress",
        "issued_at",
        "expires_at",
        "nonce",
        "uses_allowed",
        "attestation"
      ],
      "title": "ExecutionGrant",
      "type": "object"
    },
