        },
        "external_teacher": {
          "enum": [
            "denied",
            "approved"
          ],
          "title": "External Teacher",
          "type": "string"
        },
        "monitoring_upload": {
          "enum": [
            "denied",
            "approved"
          ],
          "title": "Monitoring Upload",
          "type": "string"
        },
        "public_publication": {
          "enum": [
            "denied",
            "approved"
          ],
          "title": "Public Publication",
          "type": "string"
        }
