{
  "$defs": {
    "CompatibilityIssue": {
      "additionalProperties": false,
      "description": "One reason a Climb might not run here.",
      "properties": {
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "code": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "message": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "blocking"
      ],
      "title": "CompatibilityIssue",
      "type": "object"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "EngineCompatibilityStatus": {
      "description": "What is known about the required engine on this host.",
      "enum": [
        "unknown",
        "not_installed",
        "installed_unverified",
        "verified"
      ],
      "title": "EngineCompatibilityStatus",
      "type": "string"
    },
    "NonEmptyString": {
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "https://schemas.techtree.dev/v2/compatibility-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Whether this host can run this Campaign, and what stands in the way.\n\n`required_engine_digest` is the engine the publisher validated the taskset against, from the\nvalidation receipt; `evaluation_engine_digest` is the engine the plan pins. They are reported\nside by side because a host holding one and not the other has to be told.",
  "properties": {
    "compatible": {
      "title": "Compatible",
      "type": "boolean"
    },
    "engine_status": {
      "$ref": "#/$defs/EngineCompatibilityStatus"
    },
    "evaluation_engine_digest": {
      "$ref": "#/$defs/Digest"
    },
    "evaluation_engine_source_commit": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "execution_backend_kind": {
      "const": "local",
      "title": "Execution Backend Kind",
      "type": "string"
    },
    "execution_backend_supported": {
      "title": "Execution Backend Supported",
      "type": "boolean"
    },
    "execution_plan_digest": {
      "$ref": "#/$defs/Digest"
    },
    "host_platform": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "host_supported": {
      "title": "Host Supported",
      "type": "boolean"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/CompatibilityIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "required_engine_digest": {
      "$ref": "#/$defs/Digest"
    },
    "subject_backend_kind": {
      "const": "direct",
      "title": "Subject Backend Kind",
      "type": "string"
    },
    "subject_backend_supported": {
      "title": "Subject Backend Supported",
      "type": "boolean"
    }
  },
  "required": [
    "compatible",
    "host_platform",
    "host_supported",
    "required_engine_digest",
    "engine_status",
    "execution_plan_digest",
    "evaluation_engine_source_commit",
    "evaluation_engine_digest",
    "execution_backend_kind",
    "execution_backend_supported",
    "subject_backend_kind",
    "subject_backend_supported",
    "issues"
  ],
  "title": "CompatibilityResultV2",
  "type": "object"
}
