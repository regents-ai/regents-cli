{
  "$defs": {
    "AcknowledgementMethod": {
      "enum": [
        "explicit_cli_review",
        "host_agent_confirmation"
      ],
      "type": "string"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "ExecutorKind": {
      "const": "verifiers",
      "type": "string"
    },
    "NonEmptyString": {
      "minLength": 1,
      "type": "string"
    },
    "PolicyAcknowledgement": {
      "additionalProperties": false,
      "description": "That a specific rights policy was accepted, how, and when.",
      "properties": {
        "acknowledged_at": {
          "$ref": "#/$defs/UtcDateTime"
        },
        "data_policy_digest": {
          "$ref": "#/$defs/Digest"
        },
        "method": {
          "$ref": "#/$defs/AcknowledgementMethod"
        }
      },
      "required": [
        "data_policy_digest",
        "method",
        "acknowledged_at"
      ],
      "title": "PolicyAcknowledgement",
      "type": "object"
    },
    "ProgramRef": {
      "additionalProperties": false,
      "description": "A reserved pointer at a future ImprovementProgram.",
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "ProgramRef",
      "type": "object"
    },
    "PublicContext": {
      "additionalProperties": false,
      "description": "The optional public Climb an execution artifact was produced under.",
      "properties": {
        "climb_digest": {
          "$ref": "#/$defs/Digest"
        },
        "kind": {
          "const": "climb",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "climb_digest"
      ],
      "title": "PublicContext",
      "type": "object"
    },
    "UtcDateTime": {
      "format": "date-time",
      "type": "string"
    }
  },
  "$id": "https://schemas.techtree.dev/v4/run-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What was asked for, fixed at the moment the run was created.",
  "properties": {
    "baseline_manifest_digest": {
      "$ref": "#/$defs/Digest"
    },
    "campaign_spec_digest": {
      "$ref": "#/$defs/Digest"
    },
    "candidate_manifest_digest": {
      "$ref": "#/$defs/Digest"
    },
    "created_at": {
      "$ref": "#/$defs/UtcDateTime"
    },
    "data_policy_digest": {
      "$ref": "#/$defs/Digest"
    },
    "draft_digest": {
      "$ref": "#/$defs/Digest"
    },
    "draft_id": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "execution_plan_digest": {
      "$ref": "#/$defs/Digest"
    },
    "executor_kind": {
      "$ref": "#/$defs/ExecutorKind"
    },
    "outcome_contract_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_acknowledgement": {
      "$ref": "#/$defs/PolicyAcknowledgement"
    },
    "program_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProgramRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "public_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/PublicContext"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "schema_version": {
      "const": "techtree.run-request.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "taskset_lock_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "draft_id",
    "draft_digest",
    "campaign_spec_digest",
    "program_ref",
    "public_context",
    "data_policy_digest",
    "outcome_contract_digest",
    "execution_plan_digest",
    "taskset_lock_digest",
    "baseline_manifest_digest",
    "candidate_manifest_digest",
    "policy_acknowledgement",
    "executor_kind",
    "created_at"
  ],
  "title": "RunRequestV2",
  "type": "object"
}
